<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== DARK PALETTE ====================
         Same keys and the same contrast guarantees as Theme.Light.xaml, but
         deliberately not a mechanical inversion.

         It is blue-black rather than neutral grey so it sits beside a game
         without a colour cast, and it is not pure black: a #000000 workspace
         makes thin light text bloom against it and is harder to read for long
         stretches than a lifted near-black.

         AccentFill is the exception to the light theme's "darken the fill"
         rule. On dark, white-on-#0F6FD6 measures 4.92:1 but the fill itself
         disappears into the background, so the switch uses the lighter blue and
         keeps white text (3.75:1 on 22px of solid colour, which is a graphic
         rather than body text). Accent stays the darker blue for anything
         carrying text.
    -->

    <SolidColorBrush x:Key="BgBase"       Color="#FF14171C"/>
    <SolidColorBrush x:Key="BgSurface"    Color="#FF1B1F26"/>
    <SolidColorBrush x:Key="BgSurfaceAlt" Color="#FF21262E"/>
    <SolidColorBrush x:Key="BgHover"      Color="#FF272D37"/>
    <!-- Slightly lifted from the light theme's preview so it does not read as a
         hole punched through a dark panel. -->
    <SolidColorBrush x:Key="BgPreview"    Color="#FF0E1520"/>

    <SolidColorBrush x:Key="BorderSoft"   Color="#FF2C333D"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#FF3F4956"/>

    <SolidColorBrush x:Key="TextPrimary"   Color="#FFEDF1F6"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFAFBAC7"/>
    <SolidColorBrush x:Key="TextDim"       Color="#FF8B96A4"/>
    <SolidColorBrush x:Key="TextOnAccent"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnPreview" Color="#FF8E9CB0"/>
    <SolidColorBrush x:Key="TextOnPreviewDim" Color="#FF4A5A70"/>

    <SolidColorBrush x:Key="Accent"      Color="#FF4EA1F2"/>
    <SolidColorBrush x:Key="AccentFill"  Color="#FF1B84F0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF74B6F6"/>
    <SolidColorBrush x:Key="AccentMuted" Color="#FF1B2A3D"/>
    <SolidColorBrush x:Key="Danger"      Color="#FFD93A4C"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FFE35666"/>
    <SolidColorBrush x:Key="DangerPress" Color="#FFB02436"/>
    <SolidColorBrush x:Key="Success"     Color="#FF3FBF7F"/>

    <SolidColorBrush x:Key="Scrim"      Color="#B30A0D12"/>
    <SolidColorBrush x:Key="DropShadow" Color="#FF000000"/>
    <SolidColorBrush x:Key="MenuShadow" Color="#FF000000"/>
    <SolidColorBrush x:Key="RowActive"  Color="#FF1E2B3C"/>

</ResourceDictionary>
