<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== LIGHT PALETTE ====================
         Every text colour here is measured against every surface it can land on
         (BgBase, BgSurface, BgSurfaceAlt, BgHover, AccentMuted) and clears WCAG
         AA 4.5:1 for its size. Theme.Dark.xaml is the same set of keys with the
         same contrast guarantees; if you change a key in one, change it in the
         other or the theme swap will leave a stale brush behind.
    -->

    <SolidColorBrush x:Key="BgBase"       Color="#FFEDF1F6"/>
    <SolidColorBrush x:Key="BgSurface"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BgSurfaceAlt" Color="#FFF6F8FC"/>
    <SolidColorBrush x:Key="BgHover"      Color="#FFE7EDF6"/>
    <!-- The preview is a viewport, not a panel: it stays dark in both themes so
         the captured frame is judged on its own. -->
    <SolidColorBrush x:Key="BgPreview"    Color="#FF16212E"/>

    <SolidColorBrush x:Key="BorderSoft"   Color="#FFDCE3EC"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#FFB6C2D1"/>

    <SolidColorBrush x:Key="TextPrimary"   Color="#FF16202C"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF46525F"/>
    <SolidColorBrush x:Key="TextDim"       Color="#FF626F7C"/>
    <SolidColorBrush x:Key="TextOnAccent"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnPreview" Color="#FF9DACBF"/>
    <SolidColorBrush x:Key="TextOnPreviewDim" Color="#FF5C6E85"/>

    <SolidColorBrush x:Key="Accent"      Color="#FF0F6FD6"/>
    <SolidColorBrush x:Key="AccentFill"  Color="#FF1B84F0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF0B5CBB"/>
    <SolidColorBrush x:Key="AccentMuted" Color="#FFE3F0FE"/>
    <SolidColorBrush x:Key="Danger"      Color="#FFC4142A"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FF9E0F21"/>
    <SolidColorBrush x:Key="DangerPress" Color="#FF7E0B1A"/>
    <SolidColorBrush x:Key="Success"     Color="#FF0F7A47"/>

    <SolidColorBrush x:Key="Scrim"      Color="#8C16202C"/>
    <SolidColorBrush x:Key="DropShadow" Color="#FF0B121B"/>
    <SolidColorBrush x:Key="MenuShadow" Color="#FF33415C"/>
    <!-- Tinted wash for an enabled filter row. Held as a brush rather than
         computed in a converter so it can follow the active theme. -->
    <SolidColorBrush x:Key="RowActive"  Color="#FFF2F7FE"/>

</ResourceDictionary>
