<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette. Swapped at runtime by ThemeManager, which replaces this single
         merged dictionary with Theme.Dark.xaml. Everything below refers to these
         brushes with DynamicResource so a swap repaints live; using
         StaticResource here would freeze the light values at load time. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.Light.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== DESIGN NOTES ====================
         RXShade sits beside a game, so the workspace stays quiet and the only
         saturated thing on screen is the picture in the preview.

         The choices that matter, because the defaults are everywhere:
           - Sentence case labels, not all-caps eyebrows.
           - No coloured strip down the side of a card. An active filter is
             shown by a tinted row, an accent hairline and the switch itself.
           - One repeated primitive: a filter row that reveals its sliders only
             while the filter is on, so the list stays scannable.
           - No decorative gradients, blobs or icons. Depth comes from a
             nine-step grey ramp and two shadow levels, nothing else.
           - Franklin Gothic for headings (a real grotesque with weight),
             Segoe UI for text, Consolas only for numeric readouts.

         Contrast. Every text colour in either palette is measured against every
         surface it can land on (BgBase, BgSurface, BgSurfaceAlt, BgHover,
         AccentMuted) and clears WCAG AA 4.5:1 for its size. TextDim was
         #75828F, which measured 3.46:1 on BgBase and was the main reason the
         small print was tiring to read; it is now 4.53:1 in light and 5.5:1 in
         dark. White on Accent was 3.75:1 and is now 4.92:1. Keep this invariant
         when changing any colour in Theme.Light.xaml or Theme.Dark.xaml.
    -->

    <sys:Double x:Key="RadiusCard">10</sys:Double>

    <!-- Shared keyboard affordance. WPF draws no focus visual on a templated
         control unless it is asked to, and the slider and switch are the two
         controls a keyboard user actually needs to reach. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="8"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TYPE ==================== -->
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontFamily" Value="Franklin Gothic Medium, Franklin Gothic, Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Sits above a group, so it is a touch darker than a caption and carries
         real letter-spacing to separate it from the rows beneath. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="FontFamily" Value="Franklin Gothic Medium, Franklin Gothic, Segoe UI"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextBlock.LineHeight" Value="16"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Filter rows share one subtitle treatment, so the dozens of near-miss
         font sizes that used to be set inline stay collapsed into one place. -->
    <Style x:Key="RowCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <!-- Numbers only. Monospaced so readouts do not jitter frame to frame. -->
    <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="MinWidth" Value="38"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- A statement of what is on screen right now, not a footnote. -->
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- ==================== FILTER ROW ====================
         One filter, one card. Off, it is a single calm line. On, the sliders
         unfold under a hairline rule. That is why nine filters fit a panel that
         previously overflowed by a factor of two and a half.

         There is no shadow here: the tint and the accent hairline already say
         which rows are live, and a drop shadow on every card is the clearest
         single sign of a generated interface.
    -->
    <Style x:Key="FilterRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Style.Triggers>
            <!--
              The enabled tint lives here rather than in a value converter so it
              is a normal DynamicResource and follows a theme change. A converter
              returning frozen brushes would keep painting the light tint after
              the user switched to dark.

              Nine DataTriggers is more markup than one binding, but it is the
              only way to express "tint this row when its own filter is on"
              without the converter, and it keeps the palette in one place.
            -->
            <DataTrigger Binding="{Binding Settings.SharpenEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.FxaaEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.BloomEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.ReflectionEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.FocusEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.HdrEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.ColorGradeEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.ChromaticEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Settings.GrainEnabled}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowActive}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterParameters" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
        <Style.Triggers>
            <!-- IsEnabled is already bound to the same settings flag that drives
                 this, so a disabled row dims and goes away together. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small, low-saturation annotation such as the APPROX markers. -->
    <Style x:Key="TagChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
    </Style>

    <Style x:Key="TagChipText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style x:Key="FieldRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ==================== TOGGLE SWITCH ==================== -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track"
                                CornerRadius="11"
                                Background="{DynamicResource BgHover}"
                                BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1"/>
                        <Ellipse x:Name="Knob"
                                 Width="16" Height="16"
                                 Fill="White"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="3,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="Black"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFill}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFill}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SLIDER ==================== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Glow" Width="26" Height="26" Fill="{DynamicResource Accent}" Opacity="0"/>
                        <Ellipse x:Name="Dot" Fill="White" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.18"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="5" CornerRadius="2.5"
                            Background="{DynamicResource Accent}"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="18"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <!-- 22px of vertical hit area for a 5px rule: the pointer target is the
             control, not the line. -->
        <Setter Property="Height" Value="22"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="5" CornerRadius="2.5"
                                Background="{DynamicResource BgHover}"
                                BorderBrush="{DynamicResource BorderSoft}"
                                BorderThickness="1"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== BUTTONS ==================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontFamily" Value="Franklin Gothic Medium, Franklin Gothic, Segoe UI"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource Accent}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <!-- Pressed goes darker, not lighter: a button that
                                 brightens under the pointer reads as a link. -->
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource Danger}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Background="Transparent"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== PRESET CHIP ====================
         Styled to fill the cell it is given, so the presets can be laid out as a
         steady two-column grid instead of a ragged wrapped row.
    -->
    <Style x:Key="PresetChip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <!-- Unnamed on purpose: a Style setter cannot register a name in
                     the template namescope, and the press animation below targets
                     RenderTransform.ScaleX/Y by path instead. -->
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1" CornerRadius="6" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentMuted}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Press feedback: 3% down, 90ms. Enough to feel like the chip took
                 the click, small enough that it never reads as an effect. On the
                 render transform so nothing re-measures and the grid cannot shift
                 under the pointer. -->
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.97" Duration="0:0:0.09"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.97" Duration="0:0:0.09"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Kept so older markup referencing it still resolves. -->
    <Style x:Key="SegmentedRadio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentMuted}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== COMBO BOX ==================== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1" CornerRadius="6"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Data="M 0 0 L 4 4 L 8 0"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,14,0" IsHitTestVisible="False"/>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgSurface}"
                                    BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1" CornerRadius="6"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="320" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#FF000000"/>
                                </Border.Effect>
                                <!-- Explicit visibility, and no horizontal bar: the
                                     default template would otherwise be free to show
                                     system scrollbar chrome inside the dropdown. -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentMuted}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SCROLLBAR ==================== -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource BorderStrong}"
                                                    CornerRadius="3" Width="6"
                                                    HorizontalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit as well as keyed: any ScrollBar that is not handed the keyed
         style - including ones WPF generates inside a control template, such as
         a ComboBox popup - would otherwise fall back to the system chrome, which
         is a light-grey track with arrows and looks wrong in the dark palette. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"/>
                        <!--
                          The bar template is written out here rather than pulled
                          in with Style="{StaticResource ThinScrollBar}". That
                          lookup does not resolve from inside a ControlTemplate in
                          this merged dictionary - the ScrollBar is left with a
                          null Style and falls back to the system scrollbar: a
                          17px track with arrow buttons in the light system grey
                          (#F0F0F0), which is badly wrong in the dark palette.

                          Inlining is the fix. It costs a few lines and removes
                          the lookup entirely, so the bar cannot silently revert.
                        -->
                        <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Width="10"
                                   Background="Transparent"
                                   Focusable="False"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                            <ScrollBar.Template>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                              Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{DynamicResource BorderStrong}"
                                                                    CornerRadius="3" Width="6"
                                                                    HorizontalAlignment="Center"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                              Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollBar.Template>
                        </ScrollBar>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== HYPERLINK ====================
         Used for the footer credit that opens the developer's site in the
         default browser.
    -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== TOOLTIP ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- Inverted panel: TextPrimary as the fill and BgBase as the
                         ink. That pairing flips correctly on its own when the
                         palette swaps - dark tooltip with light text in light
                         mode, light tooltip with dark text in dark mode - so the
                         tip always contrasts with the app behind it. -->
                    <Border Background="{DynamicResource TextPrimary}"
                            BorderThickness="0" CornerRadius="6" Padding="11,8">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BgBase}"/>
                                    <Setter Property="LineHeight" Value="16"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
